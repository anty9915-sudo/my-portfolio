# backend/.env.example
# 이 파일을 복사해 backend/.env 를 만들고 값을 채운다. 실제 값은 커밋하지 않는다.
# 기준 문서: CLAUDE.md 7.1
#
# 비밀값 생성 예시 (세 값은 서로 달라야 한다):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# development | test | production
NODE_ENV=development

# 기본값 3000
PORT=3000

# MongoDB Atlas 연결 문자열. DB 이름을 경로에 포함한다.
# 형식: mongodb+srv://<사용자>:<비밀번호>@<클러스터>.<id>.mongodb.net/portfolio_dev?retryWrites=true&w=majority
MONGODB_URI=

# 프론트엔드 출처 (경로·끝 슬래시 없이). 개발 예: http://localhost:5173
CLIENT_ORIGIN=

# 32자 이상 무작위 값
SESSION_SECRET=
VISIT_HASH_SECRET=
FORM_TOKEN_SECRET=

# Express trust proxy 설정: false | true | 숫자(프록시 단계 수) | 서브넷 문자열
TRUST_PROXY=false

# 선택. 보통은 비워 둔다 (비워 두면 Node 기본 DNS 동작 유지).
# Windows 일부 환경에서 Node가 OS DNS 설정을 읽지 못해 Atlas 연결 시
# "querySrv ECONNREFUSED"가 날 때만, 그 PC가 쓰는 DNS 서버 IP를 쉼표로 구분해 넣는다 (최대 4개).
# 예: DNS_SERVERS=192.0.2.53,198.51.100.53
DNS_SERVERS=

# 관리자 계정 생성 스크립트 전용 (서버 실행에는 사용하지 않음)
ADMIN_EMAIL=
